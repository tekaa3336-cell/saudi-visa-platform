# ============================================
# Environment Variables
# Copy this file to .env and fill in values
# ============================================

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Application Settings
VITE_APP_NAME=Elite Visa
VITE_APP_URL=http://localhost:3000
VITE_DEFAULT_LANG=ar

# Business Contact (Edit these with real values)
VITE_BUSINESS_PHONE=+9714XXXXXXXX
VITE_BUSINESS_WHATSAPP=+97150XXXXXXXX
VITE_BUSINESS_EMAIL=info@elitevisa.demo

# WhatsApp Integration
VITE_WHATSAPP_NUMBER=97150XXXXXXXX

# Feature Flags
VITE_ENABLE_PAYMENTS=false
VITE_ENABLE_B2B=true
VITE_ENABLE_HOTELS=false
VITE_ENABLE_FLIGHTS=false

# Demo Mode (set to true for demo without backend)
VITE_DEMO_MODE=true
